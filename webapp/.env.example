OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRIMARY_MODEL=gpt-5-mini
OPENAI_REVIEW_MODEL=gpt-5
OPENAI_REASONING_EFFORT=minimal
# Optional: route billable traffic through a dedicated OpenAI project.
# Recommended when you want finance-grade workspace reconciliation in admin-webapp.
# OPENAI_PROJECT_ID=proj_...
# Optional: per-form OpenAI project routing map, JSON object keyed by form id.
# Example: {"form-1":"proj_default","form-customer-a":"proj_customer_a"}
# OPENAI_FORM_PROJECT_MAP_JSON={"form-1":"proj_default"}
# Optional: internal reference id for the API key used by this app, for local attribution/export only.
# OPENAI_API_KEY_ID=key_...
# Optional: per-form API key id map, JSON object keyed by form id.
# OPENAI_FORM_API_KEY_ID_MAP_JSON={"form-1":"key_default"}

# 部署通道：省略或 production = 正式用户环境；staging = 测试环境（须单独部署 + 独立 Supabase，见 DEPLOY_STAGING.md）
# NEXT_PUBLIC_APP_CHANNEL=staging

# 默认必须登录。纯本地不想登录、不配 Supabase 时设为 false
NEXT_PUBLIC_REQUIRE_LOGIN=true

# 仅开发：不配 Supabase 时用假登录测登录页（须 npm run dev；生产无效）
# NEXT_PUBLIC_DEV_MOCK_LOGIN=true

# Supabase（URL 必须是 https://xxx.supabase.co，不要用占位符）
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的_anon_密钥
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 详见 AUTH.md（关闭邮箱确认、Redirect URLs 等）

# 分享填表邀请邮件（服务端直发到对方邮箱）
# 推荐与 Supabase 自定义 SMTP 使用同一套发信账号；不要提交真实密钥
# FORM_SHARE_SMTP_HOST=smtp.example.com
# FORM_SHARE_SMTP_PORT=465
# FORM_SHARE_SMTP_SECURE=true
# FORM_SHARE_SMTP_USER=mailer@example.com
# FORM_SHARE_SMTP_PASS=your_app_password_or_smtp_password
# FORM_SHARE_FROM_EMAIL=OrSight <mailer@example.com>

# 管理员后台根地址（无末尾斜杠）。生产示例：https://admin.你的域名.com
# 用户端登录页会显示「进入管理员登录」链到此地址的 /login；本地可填 http://localhost:3002
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com

# Stripe Billing
# Production and Vercel Preview deployments enforce billing/quota by default.
# Local development can set BILLING_ENFORCE=false while Stripe/Supabase billing is not ready.
BILLING_ENFORCE=true
# Emergency escape hatch for production-like deployments only; do not set for normal beta operation.
# BILLING_ALLOW_UNENFORCED_BILLING=false
# NEXT_PUBLIC_APP_URL=https://orsight.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_NORMAL_MONTHLY=price_...
# STRIPE_PRICE_USAGE_CREDIT_30K=price_...
# STRIPE_PRICE_USAGE_CREDIT_50K=price_...
# STRIPE_PRICE_USAGE_CREDIT_70K=price_...
# STRIPE_PRICE_USAGE_CREDIT_100K=price_...
# BILLING_CURRENCY=usd
# BILLING_FREE_SEAT_LIMIT=100
# BILLING_FREE_MONTHLY_COST_LIMIT_CENTS=30
# BILLING_FREE_ESTIMATED_COST_USD_PER_IMAGE=0.03
# Set to 0 to disable image-count gating and rely on monthly tokens + cost cap.
# BILLING_FREE_MONTHLY_IMAGE_LIMIT=0
# BILLING_FREE_MONTHLY_CREDITS=375000
# BILLING_FREE_USAGE_UNIT=tokens
# Optional comma-separated auth user ids that bypass all billing limits forever.
# BILLING_LIFETIME_FREE_USER_IDS=618aa87b-9cab-482d-9fa0-fda3558c2a42,6fe48ae3-9c72-4be2-a731-2822969928a7,980a56ab-d479-4fd2-b2c3-13dde4c74cbd
# BILLING_NORMAL_MONTHLY_FEE_CENTS=999
# BILLING_NORMAL_MONTHLY_CREDITS=10000000
# BILLING_NORMAL_USAGE_UNIT=tokens
# BILLING_USAGE_CREDIT_30K_TOKENS=30000
# BILLING_USAGE_CREDIT_30K_PRICE_CENTS=300
# BILLING_USAGE_CREDIT_50K_TOKENS=50000
# BILLING_USAGE_CREDIT_50K_PRICE_CENTS=500
# BILLING_USAGE_CREDIT_70K_TOKENS=70000
# BILLING_USAGE_CREDIT_70K_PRICE_CENTS=700
# BILLING_USAGE_CREDIT_100K_TOKENS=100000
# BILLING_USAGE_CREDIT_100K_PRICE_CENTS=1000
# BILLING_EXTRACT_ESTIMATED_TOKENS_PER_FILE=75000
# BILLING_TEMPLATE_ESTIMATED_TOKENS=75000
# BILLING_PREVIEW_ESTIMATED_TOKENS=75000
# BILLING_GUIDANCE_ESTIMATED_TOKENS=50000
